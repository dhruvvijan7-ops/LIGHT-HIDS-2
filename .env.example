# Sentinel — Environment Configuration (example only)
# Copy this file to .env and fill in real values for local development.
# Never commit .env to version control — it is gitignored.

# ============================================================
# Server
# ============================================================
SENTINEL_SERVER__HOST=127.0.0.1
SENTINEL_SERVER__PORT=8080

# ============================================================
# Database (PostgreSQL 18 via Docker compose)
# ============================================================
# These DSNs are for the 3-role topology. Passwords are supplied
# via environment at runtime — never write them into .env for
# public sharing or CI.
SENTINEL_DATABASE_URL=postgresql+psycopg://sentinel_app:sentinel_app@127.0.0.1:54321/sentinel
SENTINEL_DATABASE_MIGRATOR_URL=postgresql+psycopg://sentinel_migrator:sentinel_migrator@127.0.0.1:54321/sentinel
SENTINEL_DATABASE_WORKER_URL=postgresql+psycopg://sentinel_worker:sentinel_worker@127.0.0.1:54321/sentinel

# ============================================================
# Storage
# ============================================================
SENTINEL_STORAGE_ROOT=C:\ProgramData\Sentinel\data

# ============================================================
# Ingest (Stage-3 hostile-file gate)
# ============================================================
SENTINEL_INGEST_MAX_REQUEST_BYTES=67108864
SENTINEL_INGEST_MAX_FILE_BYTES=67108864
SENTINEL_INGEST_MAX_FIELD_BYTES=8192

# ============================================================
# Detection
# ============================================================
SENTINEL_DETECTION_STATEMENT_TIMEOUT_MS=60000
SENTINEL_DETECTION_NATIVE_ENABLED=true

# ============================================================
# Retention
# ============================================================
SENTINEL_RETENTION_RAW_DAYS=90
SENTINEL_RETENTION_EVENT_DAYS=365
SENTINEL_RETENTION_FINDING_DAYS=730

# ============================================================
# Observability
# ============================================================
SENTINEL_OBSERVABILITY_LOG_LEVEL=info
SENTINEL_OBSERVABILITY_LOG_FORMAT=json
SENTINEL_OBSERVABILITY_METRICS_ENABLED=true

# ============================================================
# Security
# ============================================================
SENTINEL_SECURITY_API_KEY_HEADER=X-API-Key

# ============================================================
# Dev-only API keys (Stage-6 auth replaces this stub)
# ============================================================
# Each line defines one dev principal. Format:
# SENTINEL_AUTH_DEV_KEYS=key=dev-key-default-0000000000000001&tenant_id=default&workspace_id=default&principal_id=00000000-0000-7000-8000-000000000001&scopes=upload,read:events,read:findings
# You may repeat the parameter for multiple keys.