{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel.local/schemas/canonical_event_v1.schema.json",
  "title": "Sentinel canonical event v1",
  "description": "Normalised host/network telemetry record for Sentinel HIDS. Source parsers emit this shape; detectors consume only this shape. Absent field = value absent in source. Bare JSON null is forbidden; null/unknown/invalid/conflicting/inferred values use the value-state object. Sentinel-authored classifications must set event.derived_by to 'sentinel' (or value-state $state 'inferred').",
  "type": "object",
  "required": ["schema_version", "event", "tenant_id", "workspace_id", "run_id", "time", "host", "user", "source", "raw"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "canonical-event/v1" },
    "event": { "$ref": "#/$defs/event" },
    "tenant_id": { "type": "string", "minLength": 1 },
    "workspace_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "time": { "$ref": "#/$defs/time" },
    "host": { "$ref": "#/$defs/host" },
    "user": { "$ref": "#/$defs/user" },
    "source": { "$ref": "#/$defs/source" },
    "classification": {
      "description": "Data-sensitivity axis (Stage-1 §6.4): public | internal | restricted. Third of the three non-collapsible classification axes. Set by the parser per source (e.g. Windows Security EVTX => restricted); drives export/redaction policy. Optional on the wire (older parsers may omit); the ingest pipeline backfills a per-source default and schema.sql enforces NOT NULL at rest.",
      "enum": ["public", "internal", "restricted"]
    },
    "raw": {
      "description": "Verbatim source record, lossless (string for text/evtx-rendered sources, object for JSON sources).",
      "type": ["string", "object", "array", "number", "boolean", "null"]
    },
    "unmapped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "value": {}
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_ref"],
        "additionalProperties": false,
        "properties": {
          "source_ref": { "type": "string" },
          "fields": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "process": { "$ref": "#/$defs/process" },
    "network": { "$ref": "#/$defs/network" },
    "file": { "$ref": "#/$defs/file" },
    "registry": { "$ref": "#/$defs/registry" },
    "authentication": { "$ref": "#/$defs/authentication" },
    "account": { "$ref": "#/$defs/account" },
    "group_membership": { "$ref": "#/$defs/group_membership" },
    "service": { "$ref": "#/$defs/service" },
    "scheduled_task": { "$ref": "#/$defs/scheduled_task" },
    "dns": { "$ref": "#/$defs/dns" },
    "http": { "$ref": "#/$defs/http" },
    "tls": { "$ref": "#/$defs/tls" },
    "image_load": { "$ref": "#/$defs/image_load" },
    "driver": { "$ref": "#/$defs/driver" },
    "wmi": { "$ref": "#/$defs/wmi" },
    "powershell": { "$ref": "#/$defs/powershell" },
    "thread_access": { "$ref": "#/$defs/thread_access" },
    "pipe": { "$ref": "#/$defs/pipe" },
    "third_party_alert": { "$ref": "#/$defs/third_party_alert" },
    "fim": { "$ref": "#/$defs/fim" },
    "config_check": { "$ref": "#/$defs/config_check" },
    "artifact": { "$ref": "#/$defs/artifact" },
    "document": { "$ref": "#/$defs/document" },
    "archive_member": { "$ref": "#/$defs/archive_member" },
    "executable": { "$ref": "#/$defs/executable" },
    "artifact_finding": { "$ref": "#/$defs/artifact_finding" }
  },
  "allOf": [
    { "if": { "properties": { "event": { "properties": { "category": { "const": "process" } }, "required": ["category"] } }, "required": ["event"] }, "then": { "required": ["process"] } },
    { "if": { "properties": { "event": { "properties": { "category": { "const": "network" } }, "required": ["category"] } }, "required": ["event"] }, "then": { "required": ["network"] } },
    { "if": { "properties": { "event": { "properties": { "category": { "const": "file" } }, "required": ["category"] } }, "required": ["event"] }, "then": { "required": ["file"] } },
    { "if": { "properties": { "event": { "properties": { "category": { "const": "registry" } }, "required": ["category"] } }, "required": ["event"] }, "then": { "required": ["registry"] } },
    { "if": { "properties": { "event": { "properties": { "category": { "const": "authentication" } }, "required": ["category"] } }, "required": ["event"] }, "then": { "required": ["authentication"] } },
    { "if": { "properties": { "event": { "properties": { "category": { "const": "account" } }, "required": ["category"] } }, "required": ["event"] }, "then": { "required": ["account"] } },
    { "if": { "properties": { "event": { "properties": { "category": { "const": "group_membership" } }, "required": ["category"] } }, "required": ["event"] }, "then": { "required": ["group_membership"] } },
    { "if": { "properties": { "event": { "properties": { "category": { "const": "service" } }, "required": ["category"] } }, "required": ["event"] }, "then": { "required": ["service"] } },
    { "if": { "properties": { "event": { "properties": { "category": { "const": "scheduled_task" } }, "required": ["category"] } }, "required": ["event"] }, "then": { "required": ["scheduled_task"] } },
    { "if": { "properties": { "event": { "properties": { "category": { "const": "dns" } }, "required": ["category"] } }, "required": ["event"] }, "then": { "required": ["dns"] } },
    { "if": { "properties": { "event": { "properties": { "category": { "const": "http" } }, "required": ["category"] } }, "required": ["event"] }, "then": { "required": ["http"] } },
    { "if": { "properties": { "event": { "properties": { "category": { "const": "tls" } }, "required": ["category"] } }, "required": ["event"] }, "then": { "required": ["tls"] } },
    { "if": { "properties": { "event": { "properties": { "category": { "const": "image_load" } }, "required": ["category"] } }, "required": ["event"] }, "then": { "required": ["image_load"] } },
    { "if": { "properties": { "event": { "properties": { "category": { "const": "driver" } }, "required": ["category"] } }, "required": ["event"] }, "then": { "required": ["driver"] } },
    { "if": { "properties": { "event": { "properties": { "category": { "const": "wmi" } }, "required": ["category"] } }, "required": ["event"] }, "then": { "required": ["wmi"] } },
    { "if": { "properties": { "event": { "properties": { "category": { "const": "powershell" } }, "required": ["category"] } }, "required": ["event"] }, "then": { "required": ["powershell"] } },
    { "if": { "properties": { "event": { "properties": { "category": { "const": "thread_access" } }, "required": ["category"] } }, "required": ["event"] }, "then": { "required": ["thread_access"] } },
    { "if": { "properties": { "event": { "properties": { "category": { "const": "pipe" } }, "required": ["category"] } }, "required": ["event"] }, "then": { "required": ["pipe"] } },
    { "if": { "properties": { "event": { "properties": { "category": { "const": "third_party_alert" } }, "required": ["category"] } }, "required": ["event"] }, "then": { "required": ["third_party_alert"] } },
    { "if": { "properties": { "event": { "properties": { "category": { "const": "fim" } }, "required": ["category"] } }, "required": ["event"] }, "then": { "required": ["fim"] } },
    { "if": { "properties": { "event": { "properties": { "category": { "const": "config_check" } }, "required": ["category"] } }, "required": ["event"] }, "then": { "required": ["config_check"] } },
    { "if": { "properties": { "event": { "properties": { "category": { "const": "artifact" } }, "required": ["category"] } }, "required": ["event"] }, "then": { "required": ["artifact"] } },
    { "if": { "properties": { "event": { "properties": { "category": { "const": "document" } }, "required": ["category"] } }, "required": ["event"] }, "then": { "required": ["document"] } },
    { "if": { "properties": { "event": { "properties": { "category": { "const": "archive_member" } }, "required": ["category"] } }, "required": ["event"] }, "then": { "required": ["archive_member"] } },
    { "if": { "properties": { "event": { "properties": { "category": { "const": "executable" } }, "required": ["category"] } }, "required": ["event"] }, "then": { "required": ["executable"] } },
    { "if": { "properties": { "event": { "properties": { "category": { "const": "artifact_finding" } }, "required": ["category"] } }, "required": ["event"] }, "then": { "required": ["artifact_finding"] } }
  ],
  "$defs": {
    "state_object": {
      "description": "Value-state carrier. Bare null is forbidden in this schema; absent key = absent value. 'null' = source explicitly null/empty-typed, 'unknown' = source could not supply, 'invalid' = unparsable, 'conflicting' = multiple disagreeing candidates, 'inferred' = produced by Sentinel, not the source.",
      "type": "object",
      "required": ["$state"],
      "additionalProperties": false,
      "properties": {
        "$state": { "enum": ["null", "unknown", "invalid", "conflicting", "inferred"] },
        "$note": { "type": "string" },
        "$raw": { "type": ["string", "null"] },
        "$candidates": { "type": "array" },
        "$source_ref": { "type": "string" }
      }
    },
    "str_or_state": { "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/state_object" }] },
    "int_or_state": { "oneOf": [{ "type": "integer" }, { "$ref": "#/$defs/state_object" }] },
    "num_or_state": { "oneOf": [{ "type": "number" }, { "$ref": "#/$defs/state_object" }] },
    "bool_or_state": { "oneOf": [{ "type": "boolean" }, { "$ref": "#/$defs/state_object" }] },
    "severity_or_state": { "oneOf": [{ "enum": ["informational", "low", "medium", "high", "critical"] }, { "$ref": "#/$defs/state_object" }] },
    "time": {
      "type": "object",
      "required": ["utc", "precision", "state"],
      "additionalProperties": false,
      "properties": {
        "utc": {
          "description": "Event timestamp in UTC, RFC 3339. Null only when state is unknown/invalid.",
          "type": ["string", "null"],
          "format": "date-time"
        },
        "original": { "description": "Timestamp exactly as the source rendered it.", "type": ["string", "null"] },
        "original_timezone": { "description": "Timezone of original, e.g. '+05:30', 'Z', 'America/New_York'. Null when not determinable.", "type": ["string", "null"] },
        "timezone_source": {
          "description": "How the timezone was established. 'none' when the source supplied no timezone and run configuration did not supply one.",
          "enum": ["source_explicit", "source_documented_utc", "run_configuration", "none"]
        },
        "precision": { "enum": ["millisecond", "second", "microsecond", "nanosecond", "unknown"] },
        "state": { "enum": ["ok", "inferred", "unknown", "invalid"] }
      },
      "allOf": [
        {
          "if": { "properties": { "utc": { "type": "null" } }, "required": ["utc"] },
          "then": { "properties": { "state": { "enum": ["unknown", "invalid"] } } }
        }
      ]
    },
    "host": {
      "description": "Host identity. Required object; may be empty when the source carries no host attributes.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hostname": { "$ref": "#/$defs/str_or_state" },
        "fqdn": { "$ref": "#/$defs/str_or_state" },
        "ips": { "type": "array", "items": { "$ref": "#/$defs/str_or_state" } },
        "os": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "family": { "$ref": "#/$defs/str_or_state" },
            "build": { "$ref": "#/$defs/str_or_state" },
            "version": { "$ref": "#/$defs/str_or_state" }
          }
        },
        "arch": { "$ref": "#/$defs/str_or_state" }
      }
    },
    "user": {
      "description": "Event subject account (logon subject, detection user, owner when the source frames it as subject). Required object; may be empty when unknown.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sid": { "$ref": "#/$defs/str_or_state" },
        "name": { "$ref": "#/$defs/str_or_state" },
        "domain": { "$ref": "#/$defs/str_or_state" },
        "upn": { "$ref": "#/$defs/str_or_state" },
        "logon_id": { "$ref": "#/$defs/str_or_state" }
      }
    },
    "source": {
      "type": "object",
      "required": ["file_id", "format", "parser", "parser_version"],
      "additionalProperties": false,
      "properties": {
        "file_id": { "type": "string", "minLength": 1, "description": "Identifier of the harvested artifact (DB row / manifest id)." },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "format": {
          "description": "Level-1 file format classification.",
          "enum": ["evtx", "json", "csv", "xml", "tsv", "text", "nmap_xml", "pcap", "sqlite", "yaml", "other"]
        },
        "parser": { "type": "string", "minLength": 1 },
        "parser_version": { "type": "string", "minLength": 1 },
        "channel": { "description": "Windows event log channel or equivalent stream name.", "type": "string" },
        "provider": { "description": "Event provider / application / sensor name.", "type": "string" },
        "event_id": { "oneOf": [{ "type": "integer" }, { "type": "string" }] },
        "record": {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["event_record", "line", "row", "byte_offset", "packet", "sheet", "message"] },
            "record_id": { "type": ["integer", "string"] },
            "line": { "type": "integer" },
            "byte_offset": { "type": "integer" },
            "packet_number": { "type": "integer" },
            "row": { "type": "integer" },
            "sheet": { "type": ["integer", "string"] }
          }
        }
      }
    },
    "event": {
      "type": "object",
      "required": ["category", "type", "action", "outcome", "severity", "derived_by"],
      "additionalProperties": false,
      "properties": {
        "category": {
          "description": "Level-3 security-behaviour class; selects the required payload object.",
          "enum": [
            "process", "network", "file", "registry", "authentication", "account",
            "group_membership", "service", "scheduled_task", "dns", "http", "tls",
            "image_load", "driver", "wmi", "powershell", "thread_access", "pipe",
            "third_party_alert", "fim", "config_check", "artifact", "document",
            "archive_member", "executable", "artifact_finding"
          ]
        },
        "type": {
          "description": "Semantic event type name, lowercase snake_case (level-3 refinement), e.g. network_connection, process_create.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "action": {
          "description": "Verb for what happened (create, delete, connect, start...).",
          "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/state_object" }]
        },
        "outcome": { "enum": ["success", "failure", "unknown"] },
        "severity": { "$ref": "#/$defs/severity_or_state" },
        "derived_by": {
          "description": "Provenance of category/type/action/outcome/severity. 'source' = taken from the source taxonomy; 'sentinel' = Sentinel's own classification.",
          "enum": ["source", "sentinel"]
        }
      }
    },
    "process_ref": {
      "description": "Lightweight process identity embedded in other objects.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "guid": { "$ref": "#/$defs/str_or_state" },
        "pid": { "$ref": "#/$defs/int_or_state" },
        "exe": { "$ref": "#/$defs/str_or_state" },
        "name": { "$ref": "#/$defs/str_or_state" },
        "command_line": { "$ref": "#/$defs/str_or_state" },
        "user_sid": { "$ref": "#/$defs/str_or_state" },
        "owner_name": { "$ref": "#/$defs/str_or_state" }
      }
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "md5": { "$ref": "#/$defs/str_or_state" },
        "sha1": { "$ref": "#/$defs/str_or_state" },
        "sha256": { "$ref": "#/$defs/str_or_state" },
        "imphash": { "$ref": "#/$defs/str_or_state" },
        "other": { "$ref": "#/$defs/str_or_state" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "signed": { "$ref": "#/$defs/bool_or_state" },
        "signer": { "$ref": "#/$defs/str_or_state" },
        "status": { "$ref": "#/$defs/str_or_state" }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "guid": { "$ref": "#/$defs/str_or_state" },
        "pid": { "$ref": "#/$defs/int_or_state" },
        "ppid": { "$ref": "#/$defs/int_or_state" },
        "exe": { "$ref": "#/$defs/str_or_state" },
        "name": { "$ref": "#/$defs/str_or_state" },
        "command_line": { "$ref": "#/$defs/str_or_state" },
        "current_dir": { "$ref": "#/$defs/str_or_state" },
        "integrity_level": { "$ref": "#/$defs/str_or_state" },
        "logon_guid": { "$ref": "#/$defs/str_or_state" },
        "logon_id": { "$ref": "#/$defs/str_or_state" },
        "terminal_session_id": { "$ref": "#/$defs/int_or_state" },
        "owner_sid": { "$ref": "#/$defs/str_or_state" },
        "owner_name": { "$ref": "#/$defs/str_or_state" },
        "start_time": { "$ref": "#/$defs/str_or_state" },
        "original_file_name": { "$ref": "#/$defs/str_or_state" },
        "hashes": { "$ref": "#/$defs/hashes" },
        "signature": { "$ref": "#/$defs/signature" },
        "parent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "guid": { "$ref": "#/$defs/str_or_state" },
            "pid": { "$ref": "#/$defs/int_or_state" },
            "exe": { "$ref": "#/$defs/str_or_state" },
            "name": { "$ref": "#/$defs/str_or_state" },
            "command_line": { "$ref": "#/$defs/str_or_state" },
            "owner_sid": { "$ref": "#/$defs/str_or_state" }
          }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": { "$ref": "#/$defs/str_or_state" },
        "direction": { "oneOf": [{ "enum": ["inbound", "outbound", "internal", "external", "unknown"] }, { "$ref": "#/$defs/state_object" }] },
        "src_ip": { "$ref": "#/$defs/str_or_state" },
        "src_port": { "$ref": "#/$defs/int_or_state" },
        "dst_ip": { "$ref": "#/$defs/str_or_state" },
        "dst_port": { "$ref": "#/$defs/int_or_state" },
        "state": { "$ref": "#/$defs/str_or_state" },
        "bytes_sent": { "$ref": "#/$defs/int_or_state" },
        "bytes_received": { "$ref": "#/$defs/int_or_state" },
        "duration": { "$ref": "#/$defs/num_or_state" },
        "tcp_flags": { "$ref": "#/$defs/str_or_state" },
        "icmp_type": { "$ref": "#/$defs/int_or_state" },
        "icmp_code": { "$ref": "#/$defs/int_or_state" },
        "interface": { "$ref": "#/$defs/str_or_state" },
        "uid": { "$ref": "#/$defs/str_or_state" },
        "community_id": { "$ref": "#/$defs/str_or_state" },
        "process": { "$ref": "#/$defs/process_ref" }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/str_or_state" },
        "name": { "$ref": "#/$defs/str_or_state" },
        "directory": { "$ref": "#/$defs/str_or_state" },
        "size": { "$ref": "#/$defs/int_or_state" },
        "type": { "$ref": "#/$defs/str_or_state" },
        "attributes": { "$ref": "#/$defs/str_or_state" },
        "owner_sid": { "$ref": "#/$defs/str_or_state" },
        "owner_name": { "$ref": "#/$defs/str_or_state" },
        "created": { "$ref": "#/$defs/str_or_state" },
        "modified": { "$ref": "#/$defs/str_or_state" },
        "accessed": { "$ref": "#/$defs/str_or_state" },
        "hashes": { "$ref": "#/$defs/hashes" },
        "signature": { "$ref": "#/$defs/signature" },
        "entropy": { "$ref": "#/$defs/num_or_state" }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/str_or_state" },
        "hive": { "$ref": "#/$defs/str_or_state" },
        "key": { "$ref": "#/$defs/str_or_state" },
        "value_name": { "$ref": "#/$defs/str_or_state" },
        "value_type": { "$ref": "#/$defs/str_or_state" },
        "data": { "$ref": "#/$defs/str_or_state" },
        "old_data": { "$ref": "#/$defs/str_or_state" },
        "operation": { "oneOf": [{ "enum": ["create", "set", "delete", "rename"] }, { "$ref": "#/$defs/state_object" }] }
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logon_type": { "$ref": "#/$defs/int_or_state" },
        "logon_id": { "$ref": "#/$defs/str_or_state" },
        "logon_guid": { "$ref": "#/$defs/str_or_state" },
        "account_sid": { "$ref": "#/$defs/str_or_state" },
        "account_name": { "$ref": "#/$defs/str_or_state" },
        "account_domain": { "$ref": "#/$defs/str_or_state" },
        "target_sid": { "$ref": "#/$defs/str_or_state" },
        "target_name": { "$ref": "#/$defs/str_or_state" },
        "target_domain": { "$ref": "#/$defs/str_or_state" },
        "target_logon_id": { "$ref": "#/$defs/str_or_state" },
        "source_ip": { "$ref": "#/$defs/str_or_state" },
        "workstation": { "$ref": "#/$defs/str_or_state" },
        "auth_package": { "$ref": "#/$defs/str_or_state" },
        "elev_token": { "$ref": "#/$defs/bool_or_state" },
        "key_length": { "$ref": "#/$defs/int_or_state" },
        "process_pid": { "$ref": "#/$defs/int_or_state" },
        "process_name": { "$ref": "#/$defs/str_or_state" },
        "status": { "$ref": "#/$defs/str_or_state" },
        "sub_status": { "$ref": "#/$defs/str_or_state" },
        "failure_reason": { "$ref": "#/$defs/str_or_state" },
        "caller_process_id": { "$ref": "#/$defs/str_or_state" },
        "caller_process_name": { "$ref": "#/$defs/str_or_state" }
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sid": { "$ref": "#/$defs/str_or_state" },
        "name": { "$ref": "#/$defs/str_or_state" },
        "domain": { "$ref": "#/$defs/str_or_state" },
        "upn": { "$ref": "#/$defs/str_or_state" },
        "display_name": { "$ref": "#/$defs/str_or_state" },
        "sam_account_name": { "$ref": "#/$defs/str_or_state" },
        "account_type": { "oneOf": [{ "enum": ["user", "computer", "group", "other"] }, { "$ref": "#/$defs/state_object" }] },
